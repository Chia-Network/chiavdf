+/* chiavdf: instruction-set fallback for CPUs newer than the tables below.
+   GMP 6.3.0 only recognises CPUs by vendor/family/model, so newer parts
+   (Intel Ice Lake and later, AMD Zen 5 and later, Hygon) fall back to the
+   baseline x86_64 routines even though they support everything the faster
+   routines need.  When the tables do not recognise a CPU, pick routines by
+   the instructions it actually reports instead, in the spirit of Chia's
+   MPIR proxy.  None of the routines selected here use AVX/YMM, so no
+   XGETBV check is needed.
+     level 1: POPCNT + BMI1 + BMI2 (mulx, shlx, tzcnt)  -> coreihwl
+     level 2: level 1 + ADX (adcx, adox)                -> coreibwl/skylake,
+                                                           zen on AMD/Hygon
+   Set CHIAVDF_GMP_FAT_DEBUG to print the decision on stderr.  */
+static int chiavdf_isa_level (void)
+{
+  char regs[12];
+  unsigned int leaf1_ecx, leaf7_ebx;
+
+  if (__gmpn_cpuid (regs, 0) < 7)
+    return 0;
+  __gmpn_cpuid (regs, 1);
+  memcpy (&leaf1_ecx, regs + 8, 4);
+  __gmpn_cpuid (regs, 7);
+  memcpy (&leaf7_ebx, regs + 0, 4);
+
+  if (!(leaf1_ecx & (1u << 23))		/* POPCNT */
+      || !(leaf7_ebx & (1u << 3))	/* BMI1 */
+      || !(leaf7_ebx & (1u << 8)))	/* BMI2 */
+    return 0;
+  if (gmp_workaround_skylake_cpuid_bug ())
+    return 0;
+  return (leaf7_ebx & (1u << 19)) ? 2 : 1;	/* ADX */
+}
+
+static const char *chiavdf_isa_choice = "table";
+
+#define CHIAVDF_ISA_SETUP_INTEL						\
+  do {									\
+    int chiavdf_level_ = chiavdf_isa_level ();				\
+    chiavdf_isa_choice = "isa: baseline x86_64";			\
+    if (chiavdf_level_ >= 1)						\
+      {									\
+	CPUVEC_SETUP_core2;						\
+	CPUVEC_SETUP_coreinhm;						\
+	CPUVEC_SETUP_coreisbr;						\
+	CPUVEC_SETUP_coreihwl;						\
+	chiavdf_isa_choice = "isa: coreihwl";				\
+      }									\
+    if (chiavdf_level_ >= 2)						\
+      {									\
+	CPUVEC_SETUP_coreibwl;						\
+	CPUVEC_SETUP_skylake;						\
+	chiavdf_isa_choice = "isa: skylake";				\
+      }									\
+  } while (0)
 
+#define CHIAVDF_ISA_SETUP_AMD						\
+  do {									\
+    chiavdf_isa_choice = "isa: baseline x86_64";			\
+    if (chiavdf_isa_level () >= 2)					\
+      {									\
+	CPUVEC_SETUP_zen;						\
+	chiavdf_isa_choice = "isa: zen";				\
+      }									\
+  } while (0)
+
