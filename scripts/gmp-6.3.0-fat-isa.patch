@@ -249,6 +249,57 @@
 
 enum {BMI2_BIT = 8};
 
+/* chiavdf: when the model tables do not recognise a CPU, select routines
+   by the instruction sets they require.  These routines do not use AVX/YMM,
+   so no OSXSAVE/XGETBV check is needed.
+     level 1: POPCNT + BMI1 + BMI2 -> coreihwl
+     level 2: level 1 + ADX       -> coreibwl/skylake, or zen on AMD/Hygon
+   Other known models keep their table-selected routines.  */
+static int
+chiavdf_isa_level (void)
+{
+  char regs[12];
+  unsigned int leaf1_ecx, leaf7_ebx;
+
+  if (__gmpn_cpuid (regs, 0) < 7)
+    return 0;
+  __gmpn_cpuid (regs, 1);
+  memcpy (&leaf1_ecx, regs + 8, 4);
+  __gmpn_cpuid (regs, 7);
+  memcpy (&leaf7_ebx, regs, 4);
+
+  if (!(leaf1_ecx & (1u << 23))             /* POPCNT */
+      || !(leaf7_ebx & (1u << 3))          /* BMI1 */
+      || !(leaf7_ebx & (1u << BMI2_BIT)))  /* BMI2 */
+    return 0;
+  if (gmp_workaround_skylake_cpuid_bug ())
+    return 0;
+  return (leaf7_ebx & (1u << 19)) ? 2 : 1; /* ADX */
+}
+
+#define CHIAVDF_ISA_SETUP_INTEL                  \
+  do {                                           \
+    int chiavdf_level_ = chiavdf_isa_level ();     \
+    if (chiavdf_level_ >= 1)                      \
+      {                                          \
+        CPUVEC_SETUP_core2;                      \
+        CPUVEC_SETUP_coreinhm;                   \
+        CPUVEC_SETUP_coreisbr;                   \
+        CPUVEC_SETUP_coreihwl;                   \
+      }                                          \
+    if (chiavdf_level_ >= 2)                      \
+      {                                          \
+        CPUVEC_SETUP_coreibwl;                   \
+        CPUVEC_SETUP_skylake;                    \
+      }                                          \
+  } while (0)
+
+#define CHIAVDF_ISA_SETUP_AMD                    \
+  do {                                           \
+    if (chiavdf_isa_level () >= 2)                \
+      CPUVEC_SETUP_zen;                          \
+  } while (0)
+
